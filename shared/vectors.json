      "expect": "52.229700 21.012200"
    }
  },
  "panel": {
    "_": "Main screen rules (Panel.kt / desktop/tdd/panel.py). Times in minutes before now. Battery, temperature and satellites come from the last report that has them (firmware trk9 sends them in every 10th report); their age is shown only when that report is older than the last one. The data is live when the radio is connected and the last report is under 10 min old; SNR is shown only when live.",
    "freshMin": 10,
    "cases": [
      {
        "name": "live, telemetry in the last report",
        "last": 1,
        "batt": 1,
        "temp": 1,
        "sats": 1,
        "link": true,
        "expect": {
          "live": true,
          "snr": true,
          "battAge": null,
          "tempAge": null,
          "satsAge": null
        }
      },
      {
        "name": "live, telemetry 6 reports back",
        "last": 1,
        "batt": 4,
        "temp": 4,
        "sats": 4,
        "link": true,
        "expect": {
          "live": true,
          "snr": true,
          "battAge": 4,
          "tempAge": 4,
          "satsAge": 4
        }
      },
      {
        "name": "radio not connected",
        "last": 2,
        "batt": 2,
        "temp": 2,
        "sats": 2,
        "link": false,
        "expect": {
          "live": false,
          "snr": false,
          "battAge": null,
          "tempAge": null,
          "satsAge": null
        }
      },
      {
        "name": "connected, but the last report is old",
        "last": 25,
        "batt": 40,
        "temp": null,
        "sats": 40,
        "link": true,
        "expect": {
          "live": false,
          "snr": false,
          "battAge": 40,
          "tempAge": null,
          "satsAge": 40
        }
      },
      {
        "name": "no telemetry at all yet",
        "last": 1,
        "batt": null,
        "temp": null,
        "sats": null,
        "link": true,
        "expect": {
          "live": true,
          "snr": true,
          "battAge": null,
          "tempAge": null,
          "satsAge": null
        }
      }
    ]
  }
