  "gpx": {
    "_": "the GPX file of a trail (byte for byte): trail case by name, and the file name",
    "trail": "a gap is not one movement, GPS noise while still, restart of the counter, report without fix",
    "name": "trackdog-TRK1-<&>",
    "expect": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<gpx version=\"1.1\" creator=\"TrackDog\" xmlns=\"http://www.topografix.com/GPX/1/1\">\n<trk><name>trackdog-TRK1-&lt;&amp;&gt;</name>\n<trkseg>\n<trkpt lat=\"52.000000\" lon=\"21.000000\"><time>2027-01-15T08:00:00Z</time></trkpt>\n</trkseg>\n<trkseg>\n<trkpt lat=\"52.001000\" lon=\"21.000000\"><time>2027-01-15T08:20:00Z</time></trkpt>\n<trkpt lat=\"52.001020\" lon=\"21.000000\"><time>2027-01-15T08:21:00Z</time><extensions><speed>0.04</speed></extensions></trkpt>\n<trkpt lat=\"52.002000\" lon=\"21.000000\"><time>2027-01-15T08:22:00Z</time><extensions><speed>1.82</speed></extensions></trkpt>\n<trkpt lat=\"52.002000\" lon=\"21.000000\"><time>2027-01-15T08:23:00Z</time><extensions><speed>0.00</speed></extensions></trkpt>\n</trkseg></trk>\n</gpx>\n"
  },
  "trackerSettings": {
    "_": "Fields of the tracker settings screen = custom vars of firmware meshcore-tracker trk8 (TrackerMode.cpp): key, unit, range, default. A value typed in is clamped into the range. Airtime: 2 copies of ~1.2 s per report, in % of the time, rounded.",
    "fields": [
      {
        "key": "trk_fast",
        "unit": "s",
        "min": 15,
        "max": 3600,
        "default": 20
      },
      {
        "key": "trk_move",
        "unit": "s",
        "min": 15,
        "max": 3600,
        "default": 30
      },
      {
        "key": "trk_still",
        "unit": "s",
        "min": 15,
        "max": 3600,
        "default": 300
      },
      {
        "key": "trk_nap",
        "unit": "min",
        "min": 0,
        "max": 1440,
        "default": 60
      },
      {
        "key": "trk_beat",
        "unit": "min",
        "min": 15,
        "max": 1440,
        "default": 120
      },
      {
        "key": "trk_idle",
        "unit": "min",
        "min": 0,
        "max": 1440,
        "default": 15
      },
      {
        "key": "trk_home_r",
        "unit": "m",
        "min": 30,
        "max": 5000,
        "default": 150
      }
    ],
    "clamp": [
      {
        "key": "trk_fast",
        "in": 5,
        "out": 15
      },
      {
        "key": "trk_move",
        "in": 30,
        "out": 30
      },
      {
        "key": "trk_nap",
        "in": 0,
        "out": 0
      },
      {
        "key": "trk_beat",
        "in": 5000,
        "out": 1440
      }
    ],
    "airtimePct": [
      {
        "interval": 20,
        "pct": 12
      },
      {
        "interval": 30,
        "pct": 8
      },
      {
        "interval": 60,
        "pct": 4
      }
    ],
    "parseVars": {
      "text": "gps:1,tracker:1,trk_ch:Pies,trk_path:a1,trk_move:30,trk_still:300,trk_fast:20,trk_acc:1,trk_nap:60,trk_beat:120,trk_idle:15,trk_home:1,trk_home_r:150",
