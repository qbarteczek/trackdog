{
  "_": "Shared test vectors: every TrackDog version (Android app/src/test, desktop desktop/tests) must pass all of them. A change of the report format or of the trail rules goes here first, then into every version.",
  "parse": [
    {
      "name": "old firmware without speed",
      "text": "TRK1: idzie 93% 4,18V 9,3°C 12sat nr81 https://maps.google.com/?q=52.22970,21.01220",
      "snr": -7.5,
      "expect": {
        "tracker": "TRK1",
        "status": "idzie",
        "battPct": 93,
        "battMv": 4180,
        "tempC": 9.3,
        "sats": 12,
        "seq": 81,
        "lat": 52.2297,
        "lon": 21.0122,
        "hasFix": true,
        "hasPos": true,
        "stale": false,
        "speedKmh": null,
        "course": null,
        "activity": null,
        "lowBatt": false,
        "snr": -7.5
      }
    },
    {
      "name": "speed, course, activity, negative values",
      "text": "TRK1: idzie 80% 4,00V -2,5°C 9sat 12,4km/h k270 a37 nr7 https://maps.google.com/?q=52.10000,-0.50000",
      "expect": {
        "speedKmh": 12.4,
        "course": 270,
        "activity": 37,
        "tempC": -2.5,
        "lon": -0.5,
        "seq": 7,
        "snr": null
      }
    },
    {
      "name": "no fix keeps the last position as stale",
      "text": "TRK1: brak GPS 55% 3,82V 21,0°C a0 nr12 ost. https://maps.google.com/?q=52.22970,21.01220",
      "expect": {
        "status": "brak GPS",
        "stale": true,
        "hasPos": true,
        "hasFix": false,
        "sats": null,
        "activity": 0
      }
    },
    {
      "name": "stale marker on a status with a position",
      "text": "TRK1: stoi 70% 3,95V 15,0°C a1 nr40 ost. https://maps.google.com/?q=52.22970,21.01220",
      "expect": {
        "status": "stoi",
        "stale": true,
        "hasFix": false
      }
    },
    {
      "name": "asleep (firmware trk8): heartbeat with a fix",
      "text": "TRK1: śpi 88% 4,10V 12,0°C 8sat 0,0km/h a0 nr120 https://maps.google.com/?q=52.22970,21.01220",
      "expect": {
        "status": "śpi",
        "hasFix": true,
        "stale": false,
        "speedKmh": 0.0,
        "activity": 0,
        "seq": 120
      }
    },
    {
      "name": "asleep without a fix keeps the last position",
      "text": "TRK1: śpi 87% 4,09V 11,5°C a0 nr121 ost. https://maps.google.com/?q=52.22970,21.01220",
      "expect": {
        "status": "śpi",
        "hasFix": false,
        "stale": true,
        "hasPos": true
      }
    },
    {
      "name": "trk10: HDOP, posture, minutes without motion",
      "text": "TRK1: stoi 0,0km/h a1 hdop1,4 bok bz23 nr90 https://maps.google.com/?q=52.22970,21.01220",
      "expect": {
        "status": "stoi",
        "hdop": 1.4,
        "posture": "bok",
        "idleMin": 23,
        "activity": 1,
        "seq": 90,
        "hasFix": true
      }
    },
    {
      "name": "trk10 alarm: fall, with telemetry",
      "text": "TRK1: upadek 77% 3,98V 14,5°C 9sat 0,0km/h a3 hdop0,9 bok bz0 nr91 https://maps.google.com/?q=52.22970,21.01220",
      "expect": {
        "status": "upadek",
        "alarm": true,
        "battPct": 77,
        "hdop": 0.9,
        "posture": "bok",
        "idleMin": 0
      }
    },
    {
      "name": "trk10 alarm: still away from home, last known position",
      "text": "TRK1: bezruch 70% 3,95V 9,0°C a0 pion bz15 nr92 ost. https://maps.google.com/?q=52.22970,21.01220",
      "expect": {
        "status": "bezruch",
        "alarm": true,
        "posture": "pion",
        "idleMin": 15,
        "stale": true,
        "hdop": null
      }
    },
    {
      "name": "older report has no trk10 fields",
      "text": "TRK1: idzie 5,4km/h k270 a12 nr82 https://maps.google.com/?q=52.22970,21.01220",
      "expect": {
        "hdop": null,
        "posture": null,
        "idleMin": null,
        "alarm": false
      }
    },
    {
      "name": "short report of firmware trk9: no battery, temperature, satellites",
      "text": "TRK1: idzie 5,4km/h k270 a12 nr82 https://maps.google.com/?q=52.22970,21.01220",
      "expect": {
        "status": "idzie",
        "hasFix": true,
        "battPct": null,
        "battMv": null,
        "tempC": null,
        "sats": null,
        "speedKmh": 5.4,
        "course": 270,
        "activity": 12,
        "seq": 82
      }
    },
    {
      "name": "no position at all",
      "text": "TRK1: start 100% 4,20V 20,0°C nr1",
      "expect": {
        "status": "start",
        "hasPos": false,
        "lat": null,
        "lon": null,
        "battPct": 100,
        "battMv": 4200
      }
    },
    {
      "name": "SOS, low battery, name with spaces and emoji",
      "text": "Pies 🐕: SOS 9% 3,45V 5,0°C 7sat bateria! nr300 https://maps.google.com/?q=52.00000,21.00000",
      "expect": {
        "tracker": "Pies 🐕",
        "status": "SOS",
        "sos": true,
        "lowBatt": true,
        "seq": 300
      }
    },
    {
      "name": "OK after the button, dot decimals",
      "text": "TRK1: OK 50% 3.80V 10.5°C 8sat 0.0km/h a3 nr9 https://maps.google.com/?q=52.00000,21.00000",
      "expect": {
        "status": "OK",
        "battMv": 3800,
        "tempC": 10.5,
        "speedKmh": 0.0
      }
    },
    {
      "name": "position out of range is dropped",
      "text": "TRK1: idzie 50% 3,80V 10,0°C 8sat nr9 https://maps.google.com/?q=95.00000,21.00000",
      "expect": {
        "hasPos": false,
        "lat": null
      }
    },
    {
      "name": "course out of range is dropped",
      "text": "TRK1: idzie 50% 3,80V 10,0°C 8sat 5,0km/h k400 nr9 https://maps.google.com/?q=52.00000,21.00000",
      "expect": {
        "course": null,
        "speedKmh": 5.0
      }
    },
    {
      "name": "chat 1",
      "text": "Ala: idziemy na spacer",
      "expect": null
    },
    {
      "name": "chat 2",
      "text": "Ala: stoi pod sklepem",
      "expect": null
    },
    {
      "name": "no sender",
      "text": "no sender",
      "expect": null
    },
    {
      "name": "status without counter",
      "text": "Ala: OK",
      "expect": null
    }
  ],
  "trail": [
